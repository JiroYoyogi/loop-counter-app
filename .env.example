# GitHub App 認証用の設定（このファイルをコピーして .env を作成する）
# .env はリポジトリにコミットされない（.gitignore 済み）

# GitHub App の App ID（App 設定ページの "App ID"）
GITHUB_APP_ID=123456

# リポジトリへのインストール ID
# App 設定 > Install App > 対象アカウントの歯車 のURL末尾の数字
# https://github.com/settings/installations/XXXXXXXX の XXXXXXXX
GITHUB_APP_INSTALLATION_ID=12345678

# 秘密鍵（.pem）のパス。リポジトリ外に置くこと。
# ~ はホームディレクトリに展開される。
GITHUB_APP_PRIVATE_KEY_PATH=~/.config/github-apps/claude-code.pem

# 任意: トークンキャッシュの保存先（既定は下記）
# GITHUB_APP_TOKEN_CACHE_PATH=~/.config/github-apps/claude-code.token.json
