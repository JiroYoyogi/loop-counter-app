{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git merge:*)",
      "Bash(git push:*--force*)",
      "Bash(git push:*-f*)",
      "Bash(git push origin main:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api:*--method DELETE*)",
      "Bash(gh api:*-X DELETE*)",
      "Bash(git branch -D:*)",
      "Bash(git push:*:*--delete*)"
    ]
  }
}
